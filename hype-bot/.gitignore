# Секреты: ключи API хранятся только в .env и никогда не попадают в git
.env
.env.*
!.env.example
*.pem
*.key

# Локальный конфиг пользователя (шаблон — config/config.example.yaml)
config/config.yaml

# Данные и состояние бота
data/raw/
data/cache/
*.sqlite
*.sqlite3
*.db
*.db-journal
logs/
*.log

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
build/
dist/

# Архив для передачи данных
upload/

# Посделочные файлы и кривые капитала исследования воспроизводятся скриптами research/
reports/stage3/*_trades_*.parquet
reports/stage3/*_equity_*.parquet

# Данные корзины монет (скачиваются отдельно)
data/basket/

# Журнал обращений к отложенным данным хранится в git — для прозрачности
!reports/holdout_access.log
