# Скопируйте этот файл в .env и впишите ключи. Файл .env не попадает в git.
# Ключ создаётся только с правами «Контракты: Ордера, Позиции», БЕЗ вывода
# и переводов, с привязкой к вашему IP. Подробно — в README.md.

# Демо-счёт (api-demo.bybit.com) — ключ создаётся в режиме Demo Trading
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_API_SECRET=

# Реальный счёт (api.bybit.com) — заполнять только перед этапом 6
BYBIT_LIVE_API_KEY=
BYBIT_LIVE_API_SECRET=
